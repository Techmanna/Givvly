# Environment
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Application URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=

# Database & Cache
DATABASE_URL=postgresql://amex_user:amex_password@localhost:5432/givvly_dev
REDIS_URL=redis://localhost:6379

# JWT & Security
JWT_SECRET=dev_jwt_secret_super_secure_32_bytes_long
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ACCOUNT_HASH_KEY=dev_account_hash_key_for_hmac_32_bytes

# Paystack
PAYSTACK_SECRET_KEY=sk_test_mock_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_mock_paystack_public_key
PAYSTACK_BASE_URL=https://api.paystack.co

# Fees & Business Constraints
FEE_MODE=GUEST_PAYS
FEE_BPS=150
FEE_FLAT_KOBO=0
FEE_CAP_KOBO=200000
MIN_GIFT_KOBO=50000
MAX_GIFT_KOBO=100000000

# Mail
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Givvly <no-reply@givvly.ng>"