generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum EventType {
  BIRTHDAY
  WEDDING
  BABY_SHOWER
  GRADUATION
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum GiftType {
  MONEY
  PRODUCT
  POOL
  DIGITAL
}

enum GiftStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PayoutStatus {
  QUEUED
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
  ON_HOLD
}

enum AccountStatus {
  PENDING
  VERIFIED
  PENDING_REVIEW
  REJECTED
}

enum ItemStatus {
  AVAILABLE
  RESERVED
  CLAIMED
}

enum PoolMode {
  PRODUCT
  CASH
}

enum PoolStatus {
  OPEN
  FUNDED
  EXPIRED
  CONVERTED
  REFUNDED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  DISPUTED
  REFUNDED
}

enum PostStatus {
  PENDING
  VISIBLE
  HIDDEN
  REMOVED
}

enum RsvpResponse {
  YES
  NO
  MAYBE
}

enum Channel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

enum NotifStatus {
  QUEUED
  SENT
  FAILED
  READ
}

enum LedgerType {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE
}

enum Direction {
  DEBIT
  CREDIT
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum DisputeStatus {
  OPEN
  VENDOR_RESPONDED
  RESOLVED_REFUND
  RESOLVED_REJECTED
}

enum MediaStatus {
  UPLOADING
  SCANNING
  READY
  REJECTED
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

model User {
  id              String             @id @default(uuid())
  email           String             @unique
  name            String
  phone           String?
  passwordHash    String?
  googleId        String?            @unique
  role            Role               @default(USER)
  status          UserStatus         @default(ACTIVE)
  emailVerifiedAt DateTime?
  avatarKey       String?
  failedLogins            Int                @default(0)
  lockedUntil             DateTime?
  lastLoginAt             DateTime?
  walletPinHash           String?
  walletPinSetAt          DateTime?
  walletPinFailedAttempts Int                @default(0)
  walletPinLockedUntil    DateTime?
  kycTier                 Int                @default(1)
  bvnLast4                String?
  kycUpgradedAt           DateTime?
  createdAt               DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
  sessions        Session[]
  tokens          VerificationToken[]
  payoutAccounts  PayoutAccount[]
  events          Event[]
  notifications   Notification[]
  prefs           NotificationPref[]

  @@index([status])
  @@index([phone])
  @@index([createdAt(sort: Desc)])
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  familyId     String
  tokenHash    String    @unique
  userAgent    String?
  ipHash       String?
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model VerificationToken {
  id        String    @id @default(uuid())
  userId    String
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model PayoutAccount {
  id               String        @id @default(uuid())
  userId           String
  bankCode         String
  bankName         String
  accountNumberEnc String
  accountHash      String
  accountLast4     String
  accountName      String
  recipientCode    String?
  status           AccountStatus @default(PENDING)
  isDefault        Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id])

  @@unique([userId, accountHash])
  @@index([userId])
  @@index([userId, status])
  @@index([userId, isDefault])
}

model Event {
  id              String         @id @default(uuid())
  ownerId         String
  slug            String         @unique
  type            EventType
  name            String
  date            DateTime
  story           String?
  coverMediaId    String?
  visibility      Visibility     @default(PUBLIC)
  accessCodeHash  String?
  status          EventStatus    @default(DRAFT)
  allowPlusOne    Boolean        @default(true)
  payoutAccountId String?
  templateKey     String?
  templateData    Json?
  keepsakePublic  Boolean        @default(false)
  currency        String         @default("NGN")
  publishedAt     DateTime?
  closedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  owner           User           @relation(fields: [ownerId], references: [id])
  rsvps           Rsvp[]
  gifts           Gift[]
  registry        RegistryItem[]
  pools           Pool[]
  posts           WallPost[]
  orders          Order[]
  payouts         Payout[]

  @@index([ownerId, status])
  @@index([status, visibility, date])
}

model Rsvp {
  id          String       @id @default(uuid())
  eventId     String
  contactKey  String
  name        String
  email       String?
  phone       String?
  response    RsvpResponse
  plusOneName String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, contactKey])
  @@index([eventId, response])
  @@index([eventId, createdAt(sort: Desc)])
}

model RegistryItem {
  id               String      @id @default(uuid())
  eventId          String
  productId        String?
  title            String
  imageKey         String?
  priceKobo        Int
  status           ItemStatus  @default(AVAILABLE)
  reservedUntil    DateTime?
  reservationToken String?
  claimedGiftId    String?     @unique
  position         Int         @default(0)
  createdAt        DateTime    @default(now())
  event            Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  product          Product?    @relation(fields: [productId], references: [id])

  @@index([eventId, status])
  @@index([status, reservedUntil])
}

model Pool {
  id            String     @id @default(uuid())
  eventId       String
  productId     String?
  title         String
  mode          PoolMode
  targetKobo    Int
  raisedKobo    Int        @default(0)
  allowOverfund Boolean    @default(false)
  deadline      DateTime?
  status        PoolStatus @default(OPEN)
  orderId       String?    @unique
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  event         Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  gifts         Gift[]

  @@index([eventId, status])
  @@index([status, deadline])
}

model Gift {
  id             String      @id @default(uuid())
  type           GiftType
  eventId        String?
  giverUserId    String?
  giverName      String?
  giverEmail     String?
  anonymous      Boolean     @default(false)
  message        String?
  amountKobo     Int
  feeKobo        Int         @default(0)
  currency       String      @default("NGN")
  status         GiftStatus  @default(PENDING)
  registryItemId String?
  poolId         String?
  orderId        String?
  paymentId      String?     @unique
  thankedAt      DateTime?
  createdAt      DateTime    @default(now())
  event          Event?      @relation(fields: [eventId], references: [id])
  pool           Pool?       @relation(fields: [poolId], references: [id])
  payment        Payment?    @relation(fields: [paymentId], references: [id])
  payout         Payout?

  @@index([eventId, createdAt(sort: Desc)])
  @@index([eventId, status])
  @@index([poolId, status])
  @@index([giverUserId])
}

model Payment {
  id               String        @id @default(uuid())
  reference        String        @unique
  idempotencyKey   String?
  scope            String?
  provider         String        @default("PAYSTACK")
  amountKobo       Int
  feeKobo          Int           @default(0)
  providerFeeKobo  Int?
  currency         String        @default("NGN")
  status           PaymentStatus @default(INITIATED)
  accessCode       String?
  authorizationUrl String?
  channel          String?
  payerEmail       String
  metadata         Json?
  failureReason    String?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  gift             Gift?
  order            Order?

  @@unique([scope, idempotencyKey])
  @@index([status, createdAt])
}

model Payout {
  id              String        @id @default(uuid())
  reference       String        @unique
  giftId          String?       @unique
  eventId         String?
  poolId          String?
  userId          String
  payoutAccountId String
  amountKobo      Int
  transferFeeKobo Int?
  status          PayoutStatus  @default(QUEUED)
  transferCode    String?
  attempts        Int           @default(0)
  holdReason      String?
  failureReason   String?
  queuedAt        DateTime      @default(now())
  completedAt     DateTime?
  updatedAt       DateTime      @updatedAt
  gift            Gift?         @relation(fields: [giftId], references: [id])
  event           Event?        @relation(fields: [eventId], references: [id])

  @@index([status, queuedAt])
  @@index([userId])
}

model LedgerAccount {
  id       String        @id @default(uuid())
  code     String        @unique
  name     String
  type     LedgerType
  ownerId  String?
  currency String        @default("NGN")
  entries  LedgerEntry[]
}

model LedgerTransaction {
  id          String        @id @default(uuid())
  reference   String        @unique
  kind        String
  description String
  paymentId   String?
  payoutId    String?
  postedAt    DateTime      @default(now())
  metadata    Json?
  entries     LedgerEntry[]
}

model LedgerEntry {
  id            String            @id @default(uuid())
  transactionId String
  accountId     String
  direction     Direction
  amountKobo    BigInt
  createdAt     DateTime          @default(now())
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id])
  account       LedgerAccount     @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt])
  @@index([transactionId])
}

model Vendor {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  contactEmail  String
  phone         String?
  city          String?
  active        Boolean        @default(true)
  commissionBps Int            @default(0)
  createdAt     DateTime       @default(now())
  members       VendorMember[]
  products      Product[]
  orders        Order[]
}

model VendorMember {
  id       String @id @default(uuid())
  vendorId String
  userId   String @unique
  vendor   Vendor @relation(fields: [vendorId], references: [id])
}

model Product {
  id            String         @id @default(uuid())
  vendorId      String?
  slug          String         @unique
  title         String
  description   String
  priceKobo     Int
  images        Json
  occasions     String[]
  relationships String[]
  stock         Int?
  isDigital     Boolean        @default(false)
  digitalKind   String?
  active        Boolean        @default(true)
  ratingAvg     Float          @default(0)
  ratingCount   Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  vendor        Vendor?        @relation(fields: [vendorId], references: [id])
  registry      RegistryItem[]

  @@index([active, priceKobo])
  @@index([vendorId])
}

model Collection {
  id         String   @id @default(uuid())
  slug       String   @unique
  name       String
  kind       String
  productIds String[]
}

model Order {
  id              String               @id @default(uuid())
  number          String               @unique
  buyerUserId     String?
  buyerEmail      String
  eventId         String?
  vendorId        String?
  recipientName   String
  recipientPhone  String?
  recipientEmail  String?
  address         Json?
  giftNote        String?
  wrapStyle       String?
  status          OrderStatus          @default(PENDING_PAYMENT)
  subtotalKobo    Int
  deliveryFeeKobo Int                  @default(0)
  feeKobo         Int                  @default(0)
  totalKobo       Int
  paymentId       String?              @unique
  trackingToken   String               @unique
  deliveredAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  event           Event?               @relation(fields: [eventId], references: [id])
  vendor          Vendor?              @relation(fields: [vendorId], references: [id])
  payment         Payment?             @relation(fields: [paymentId], references: [id])
  items           OrderItem[]
  history         OrderStatusHistory[]
  review          Review?
  disputes        Dispute[]

  @@index([buyerUserId, createdAt])
  @@index([buyerEmail, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([vendorId, status])
  @@index([eventId])
}

model OrderItem {
  id            String  @id @default(uuid())
  orderId       String
  productId     String
  title         String
  unitPriceKobo Int
  qty           Int     @default(1)
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  note      String?
  actorId   String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Review {
  id        String   @id @default(uuid())
  orderId   String   @unique
  userId    String
  vendorId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id])
}

model Dispute {
  id           String        @id @default(uuid())
  orderId      String
  openedById   String
  type         String
  description  String
  status       DisputeStatus @default(OPEN)
  resolution   String?
  resolvedById String?
  createdAt    DateTime      @default(now())
  resolvedAt   DateTime?
  order        Order         @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status, createdAt])
}

model WallPost {
  id               String      @id @default(uuid())
  eventId          String
  authorName       String
  authorUserId     String?
  authorEmail      String?
  text             String?
  status           PostStatus  @default(PENDING)
  moderationReason String?
  giftId           String?     @unique
  ipHash           String?
  createdAt        DateTime    @default(now())
  event            Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  media            Media[]

  @@index([eventId, status, createdAt(sort: Desc)])
}

model Media {
  id          String      @id @default(uuid())
  ownerUserId String?
  key         String      @unique
  mime        String
  sizeBytes   Int
  width       Int?
  height      Int?
  kind        String      @default("IMAGE")
  purpose     String
  status      MediaStatus @default(UPLOADING)
  wallPostId  String?
  disputeId   String?
  createdAt   DateTime    @default(now())
  wallPost    WallPost?   @relation(fields: [wallPostId], references: [id])

  @@index([status])
}

model Report {
  id             String       @id @default(uuid())
  targetType     String
  targetId       String
  reason         String
  note           String?
  reporterIpHash String?
  status         ReportStatus @default(OPEN)
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([status, createdAt])
}

model Notification {
  id          String      @id @default(uuid())
  userId      String?
  toAddress   String?
  channel     Channel
  type        String
  title       String
  body        String
  data        Json?
  status      NotifStatus @default(QUEUED)
  attempts    Int         @default(0)
  providerRef String?
  error       String?
  readAt      DateTime?
  sentAt      DateTime?
  createdAt   DateTime    @default(now())
  user        User?       @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
}

model NotificationPref {
  id       String   @id @default(uuid())
  userId   String
  channel  Channel
  category String
  enabled  Boolean  @default(true)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, category])
}

model WebhookEvent {
  id          String    @id @default(uuid())
  provider    String
  eventKey    String
  eventType   String
  payload     Json
  status      String    @default("RECEIVED")
  attempts    Int       @default(0)
  error       String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventKey])
  @@index([status, receivedAt])
}

model IdempotencyRecord {
  id             String   @id @default(uuid())
  scope          String
  key            String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([scope, key])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  targetType String
  targetId   String
  ip         String?
  userAgent  String?
  diff       Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
}

model OutboxEvent {
  id        String    @id @default(uuid())
  type      String
  payload   Json
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  attempts  Int       @default(0)

  @@index([sentAt, createdAt])
}

model ReconciliationRun {
  id              String    @id @default(uuid())
  runDate         DateTime
  status          String
  paymentsChecked Int       @default(0)
  payoutsChecked  Int       @default(0)
  mismatches      Json?
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?

  @@unique([runDate])
}

